# --- Développement local ---
# Port d'écoute (conteneur ET hôte)
PORT=25XXX
# Route racine de l'application, derrière le reverse proxy (mon-domaine.fr/serverhub/)
# Vide en local ; /serverhub en production (derrière le reverse proxy).
URL_PREFIX=
# Si l'auth s'appuie sur la session partagée, reprendre la MÊME valeur que game-hub / auth
SECRET_KEY=change-me

# --- Panel Pterodactyl ---
PTERODACTYL_URL=https://panel.mon-domaine.fr
# Clé d'API « client » (compte > API Credentials), du type ptlc_...
PTERODACTYL_API_KEY=

# --- Module minijeux (serveur Minecraft distant) ---
# Identifiant Pterodactyl du serveur minijeux (celui de /serverhub/<id>)
MINIGAME_VM_PTERODACTYL_ID=
MINIGAME_VM_HOST=
MINIGAME_VM_PORT=22
MINIGAME_VM_USER=minigame-deploy
# Chemin de la clé DANS le conteneur : ne pas changer (voir volumes de docker-compose.yml)
MINIGAME_VM_SSH_KEY_PATH=/run/secrets/minigame_ssh_key
# Chemin de la clé SUR L'HOTE (lu par docker compose, pas par l'application)
MINIGAME_VM_SSH_KEY_HOST_PATH=./secrets/minigame_ssh_key
MINIGAME_VM_SCRIPT_PATH=/var/lib/pterodactyl/volumes/<uuid>/src/changeMap.sh
MINIGAME_VM_JSON_PATH=/var/lib/pterodactyl/volumes/<uuid>/src/Minigames.json

# --- Auth (service séparé, paquet auth_client) ---
# false = pas d'authentification (dev local). true en production.
AUTH_ENABLED=false
# Rôles Keycloak autorisés à gérer les serveurs, séparés par des virgules (un seul suffit).
# Vide = tout utilisateur authentifié.
AUTH_REQUIRED_ROLES=
# Auth, vu depuis le conteneur (réseau Docker "web")
AUTH_INTERNAL_URL=http://auth:25000/auth
# Auth, vu depuis le navigateur
AUTH_PUBLIC_URL=https://mon-domaine.fr/auth
# URL publique du hub, route racine incluse, sans slash final (retour après déconnexion)
PUBLIC_URL=https://mon-domaine.fr/serverhub
# Derrière un reverse proxy / HTTPS
BEHIND_PROXY=false
SESSION_COOKIE_SECURE=false
